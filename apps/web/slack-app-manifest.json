{
	"_metadata": {
		"major_version": 1,
		"minor_version": 1
	},
	"display_information": {
		"name": "LEADR Screen Recorder",
		"description": "Rich previews for LEADR Screen Recorder links in Slack.",
		"background_color": "#ab2c21"
	},
	"features": {
		"bot_user": {
			"display_name": "leadr-recorder",
			"always_online": false
		},
		"app_home": {
			"home_tab_enabled": false,
			"messages_tab_enabled": true,
			"messages_tab_read_only_enabled": true
		},
		"unfurl_domains": ["record.leadr.co"]
	},
	"oauth_config": {
		"redirect_urls": [
			"https://record.leadr.co/api/integrations/slack/callback"
		],
		"scopes": {
			"bot": [
				"links:read",
				"links:write",
				"links.embed:write",
				"chat:write",
				"users:read",
				"users:read.email"
			]
		}
	},
	"settings": {
		"event_subscriptions": {
			"request_url": "https://record.leadr.co/api/integrations/slack/events",
			"bot_events": ["link_shared", "app_uninstalled"]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
